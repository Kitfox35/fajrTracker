rules_version = '2';

// 40 Days of Fajr. These rules do NOT expire.
// Each player can only change their own check-in, enforced by their login.
// The check-in window below is enforced on Google's clock, so changing a
// phone's clock can't open it. If you change WINDOW_START / WINDOW_END in
// index.html, change windowStart() / windowEnd() here too.

service cloud.firestore {
  match /databases/{database}/documents {

    match /contests/fajr40 {
      allow get: if true;
      allow list, delete: if false;
      allow create: if isPlayer() && isValidNewContest();
      allow update: if isPlayer() && (isSetupEdit() || isCheckinChange());
    }

    // ---- Who is signed in ----

    function isSignedInAs(player) {
      return request.auth != null
        && request.auth.token.email == player + '@fajr40.example.com';
    }

    function isPlayer() { return isSignedInAs('zayd') || isSignedInAs('omar'); }

    // Minutes after midnight, Los Angeles time.
    function windowStart() { return 5 * 60 + 15; }  // 05:15
    function windowEnd()   { return 6 * 60 + 40; }  // 06:40

    // ---- Los Angeles time (handles daylight saving) ----

    function isDaylightTime(t) {
      let sunday = t.day() - (t.dayOfWeek() % 7);
      return (t.month() > 3 && t.month() < 11)
        || (t.month() == 3 && sunday >= 8)
        || (t.month() == 11 && sunday < 1);
    }

    function laNow() {
      let standard = request.time - duration.value(8, 'h');
      return isDaylightTime(standard) ? standard + duration.value(1, 'h') : standard;
    }

    function pad(n) { return n < 10 ? '0' + string(n) : string(n); }

    function dateKey(t) {
      return string(t.year()) + '-' + pad(t.month()) + '-' + pad(t.day());
    }

    function windowIsOpen() {
      let minute = laNow().hours() * 60 + laNow().minutes();
      return minute >= windowStart() && minute < windowEnd();
    }

    // ---- Setup ----

    function isValidName(name) {
      return name is string && name.size() >= 1 && name.size() <= 20;
    }

    function isValidSetup(data) {
      return data.startDate is string
        && data.startDate.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && data.startDate >= dateKey(laNow())
        && data.players is map
        && data.players.keys().hasOnly(['zayd', 'omar'])
        && data.players.keys().hasAll(['zayd', 'omar'])
        && isValidName(data.players.zayd)
        && isValidName(data.players.omar);
    }

    function isValidNewContest() {
      let data = request.resource.data;
      return data.keys().hasOnly(['startDate', 'players', 'checkins'])
        && data.checkins is map
        && data.checkins.size() == 0
        && isValidSetup(data);
    }

    // Start date and names can only change before Day 1 begins.
    function isSetupEdit() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['startDate', 'players'])
        && resource.data.startDate > dateKey(laNow())
        && isValidSetup(request.resource.data);
    }

    // ---- Check-ins: one player, today only, window open, inside the 40 days ----

    function isCheckinChange() {
      let today = dateKey(laNow());
      let before = resource.data;
      let after = request.resource.data;
      let dayBefore = before.checkins.get(today, {});
      let dayAfter = after.checkins.get(today, {});
      return windowIsOpen()
        && before.startDate <= today
        && before.startDate >= dateKey(laNow() - duration.value(39, 'd'))
        && after.diff(before).affectedKeys().hasOnly(['checkins'])
        && after.checkins.diff(before.checkins).affectedKeys().hasOnly([today])
        && isOnePlayerChange(dayBefore, dayAfter);
    }

    function isOnePlayerChange(dayBefore, dayAfter) {
      let changed = dayAfter.diff(dayBefore).affectedKeys();
      let player = changed.hasOnly(['zayd']) ? 'zayd' : 'omar';
      return changed.size() == 1
        && changed.hasOnly(['zayd', 'omar'])
        && isSignedInAs(player)
        && isValidEntry(dayBefore.get(player, { 'done': false }), dayAfter[player]);
    }

    function isValidEntry(old, entry) {
      return entry.keys().hasOnly(['done', 'timestamp'])
        && entry.done is bool
        && entry.timestamp == request.time
        && (isNewCheckin(old, entry) || isUndo(old, entry));
    }

    function isNewCheckin(old, entry) {
      return entry.done == true && old.done == false;
    }

    function isUndo(old, entry) {
      return entry.done == false
        && old.done == true
        && request.time < old.timestamp + duration.value(5, 'm');
    }
  }
}
